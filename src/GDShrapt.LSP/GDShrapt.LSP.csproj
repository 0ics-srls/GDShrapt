<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>GDShrapt.LSP</RootNamespace>
    <AssemblyName>GDShrapt.LSP</AssemblyName>
    <Description>Language Server Protocol implementation for GDScript</Description>
    <!-- Project analysis is allocation-heavy and parallel: server GC (per-core heaps) cuts wall time ~28%
         on a 1700-script project (LSAI#48). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- Classic server GC with a bounded heap count instead of DATAS (.NET 10 default): DATAS keeps gen0 budgets
         small and collects ~40x per analysis; 8 heaps cut the 1700-script analysis by ~14% for ~+0.5 GB
         (all heaps: same time, ~+1.7 GB). The runtime caps the count at the machine's cores. LSAI#48 -->
    <RuntimeHostConfigurationOption Include="System.GC.DynamicAdaptationMode" Value="0" />
    <RuntimeHostConfigurationOption Include="System.GC.HeapCount" Value="8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GDShrapt.Semantics\GDShrapt.Semantics.csproj" />
    <ProjectReference Include="..\GDShrapt.Formatter\GDShrapt.Formatter.csproj" />
    <ProjectReference Include="..\GDShrapt.CLI.Core\GDShrapt.CLI.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GDShrapt.LSP.Tests" Key="$(GDShraptPublicKey)" />
  </ItemGroup>

</Project>
